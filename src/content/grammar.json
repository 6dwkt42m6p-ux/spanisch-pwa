    "id": "g006",
    "title": "Condicional — Quisiera / Podría",
    "subtitle": "Höfliche Bitten und Wünsche",
    "level": 2,
    "explanation": "Mit dem Konditional kannst du höflich bitten und Wünsche äußern. Für Reisende ist besonders 'quisiera' (ich würde gerne) und 'podría' (könnten Sie) unverzichtbar — höflicher als das direkte 'quiero' (ich will).",
    "key_forms": [
      {"form": "quisiera", "base": "querer → Konditional", "german": "Ich würde gerne", "example_es": "Quisiera una habitación doble.", "example_de": "Ich würde gerne ein Doppelzimmer."},
      {"form": "me gustaría", "base": "gustar → Konditional", "german": "Ich würde gerne / Mir würde... gefallen", "example_es": "Me gustaría visitar Machu Picchu.", "example_de": "Ich würde gerne Machu Picchu besuchen."},
      {"form": "¿podría...?", "base": "poder → Konditional", "german": "Könnten Sie...?", "example_es": "¿Podría hablar más despacio?", "example_de": "Könnten Sie langsamer sprechen?"},
      {"form": "¿tendría...?", "base": "tener → Konditional", "german": "Hätten Sie...?", "example_es": "¿Tendría una habitación más barata?", "example_de": "Hätten Sie ein günstigeres Zimmer?"},
      {"form": "¿sería posible...?", "base": "ser → Konditional", "german": "Wäre es möglich...?", "example_es": "¿Sería posible pagar mañana?", "example_de": "Wäre es möglich, morgen zu bezahlen?"}
    ],
    "examples": [
      {"es": "Quisiera reservar una mesa para dos, por favor.", "de": "Ich würde gerne einen Tisch für zwei reservieren."},
      {"es": "Me gustaría cambiar de habitación.", "de": "Ich würde gerne das Zimmer wechseln."},
      {"es": "¿Podría recomendarme un buen restaurante?", "de": "Könnten Sie mir ein gutes Restaurant empfehlen?"},
      {"es": "¿Tendría algo más barato?", "de": "Hätten Sie etwas Günstigeres?"},
      {"es": "¿Sería posible hacer el check-out más tarde?", "de": "Wäre es möglich, später auszuchecken?"}
    ],
    "travel_tip": "Im Alltag reichen 'quisiera' und '¿podría?' für 90% der höflichen Situationen. 'Quiero' (ich will) ist grammatisch korrekt, aber kann hart klingen — quisiera ist freundlicher.",
    "exercises": [
      {"type": "fill_blank", "sentence": "______ una cerveza, por favor. (Ich hätte gerne ein Bier)", "answer": "Quisiera", "hint": "querer → Konditional"},
      {"type": "fill_blank", "sentence": "¿______ (usted) hablar más despacio?", "answer": "Podría", "hint": "poder → Konditional"},
      {"type": "translate", "german": "Ich würde gerne das Zimmer wechseln.", "answer": "Me gustaría cambiar de habitación.", "hint": "me gustaría + infinitiv"},
