      {"type": "fill_blank", "sentence": "La empanada ______ (estar) muy rica.", "answer": "está", "hint": "Zustand/Geschmack → ESTAR"},
      {"type": "fill_blank", "sentence": "Yo ______ (ser) alemán.", "answer": "soy", "hint": "Nationalität → SER"},
      {"type": "translate", "german": "Das Museum ist geschlossen. (Zustand)", "answer": "El museo está cerrado.", "hint": "Zustand → estar"},
      {"type": "multiple_choice", "question": "La habitación ______ limpia. (sauber = aktueller Zustand → estar)", "options": ["es", "está", "son", "están"], "answer": "está"}
    ]
