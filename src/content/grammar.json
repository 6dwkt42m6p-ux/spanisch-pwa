    "id": "g002",
    "title": "Ser vs. Estar",
    "subtitle": "Die zwei 'sein'-Verben",
    "level": 1,
    "explanation": "Spanisch hat zwei Verben für 'sein': SER und ESTAR. SER drückt dauerhaft-wesentliche Eigenschaften aus. ESTAR drückt Zustände, Befinden, Lage und temporäre Situationen aus. Diese Unterscheidung ist eine der wichtigsten in der spanischen Grammatik.",
    "conjugation_tables": [
      {
        "verb": "ser (sein - dauerhaft)",
        "type": "irregular",
        "rows": [
          {"person": "yo", "form": "soy", "german": "ich bin"},
          {"person": "tú", "form": "eres", "german": "du bist"},
          {"person": "él/ella", "form": "es", "german": "er/sie ist"},
          {"person": "nosotros", "form": "somos", "german": "wir sind"},
          {"person": "ellos/ustedes", "form": "son", "german": "sie/Sie sind"}
        ]
      },
      {
        "verb": "estar (sein - Zustand/Lage)",
        "type": "irregular",
        "rows": [
          {"person": "yo", "form": "estoy", "german": "ich bin"},
          {"person": "tú", "form": "estás", "german": "du bist"},
          {"person": "él/ella", "form": "está", "german": "er/sie ist"},
          {"person": "nosotros", "form": "estamos", "german": "wir sind"},
          {"person": "ellos/ustedes", "form": "están", "german": "sie/Sie sind"}
        ]
      }
    ],
    "examples": [
      {"es": "Soy de Alemania. (Herkunft → SER)", "de": "Ich bin aus Deutschland."},
      {"es": "El hotel está cerca del centro. (Lage → ESTAR)", "de": "Das Hotel liegt in der Nähe des Zentrums."},
      {"es": "La comida está muy rica. (Zustand → ESTAR)", "de": "Das Essen ist sehr lecker."},
      {"es": "El restaurante es famoso. (Eigenschaft → SER)", "de": "Das Restaurant ist berühmt."},
      {"es": "¿Estás bien? — Estoy cansado. (Befinden → ESTAR)", "de": "Geht es dir gut? — Ich bin müde."},
      {"es": "¿Dónde está la terminal? (Ort → ESTAR)", "de": "Wo ist der Busbahnhof?"}
    ],
    "memory_trick": "SER: Wer/Was bin ich dauerhaft? (Identität, Herkunft, Beruf, Nationalität, Zeit). ESTAR: Wie geht es mir / Wo bin ich? (Gefühl, Gesundheit, Position, temporärer Zustand)",
